# Ollama model store. The weights live here but are NOT committed:
# a single qwen3:0.6b layer is ~498 MiB, over GitHub's hard 100 MB file limit.
# Recreate the store with `scripts/setup-ollama.sh` — models/model-pin.json
# pins the exact digests, so every checkout gets byte-identical weights.
models/ollama/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/

# Local env
.env
.env.local

# Ollama server log written by scripts/setup-ollama.sh
models/ollama-serve.log

# Qwen3's tokenizer.json, fetched on demand by scripts/token-budget.mjs.
# 11 MB — a third of a 360M model's download, and reproducible from Hugging
# Face, so it is cached rather than committed.
scripts/.tokenizer-cache/
